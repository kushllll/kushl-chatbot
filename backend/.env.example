# Backend Environment Configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://kushl@localhost:5432/kushalchat

# OpenRouter Credentials
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Firebase Authentication (Optional in development; use real project in production)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.netlify.app
